# ── Serveri ──────────────────────────────────────────────
PORT=3000
# Adresa publike e faqes (pa / në fund). Përdoret për kthimin nga pagesa.
BASE_URL=http://localhost:3000
# Ku ruhen databaza dhe fotot/videot. Në hosting duhet të jetë disk i përhershëm (volume).
DATA_DIR=./data
# Madhësia maksimale e një skedari (MB)
MAX_UPLOAD_MB=2048
# Vendos 1 kur faqja është në HTTPS (prodhim)
COOKIE_SECURE=0

# ── Llogaria e administratorit (vetëm ti) ───────────────
# Krijohet automatikisht në nisjen e parë. Ndrysho fjalëkalimin pas hyrjes së parë.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Pagesa: whop ose stripe ─────────────────────────────
PAYMENT_PROVIDER=whop

# Whop: linku i checkout-it vendoset te Paneli → Cilësimet (ose këtu)
WHOP_CHECKOUT_URL=
# Sekreti i webhook-ut nga Whop Dashboard → Developer → Webhooks
WHOP_WEBHOOK_SECRET=

# Stripe (alternativë)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
